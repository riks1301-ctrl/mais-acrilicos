# ─── Obrigatório ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/mais_acrilicos"
JWT_SECRET="sua-chave-secreta-jwt-minimo-32-caracteres-aleatorios"
ADMIN_EMAIL="admin@maisacrilicos.com.br"
ADMIN_PASSWORD="altere-esta-senha-forte"
NEXT_PUBLIC_SITE_URL="https://www.maisacrilicos.com.br"
NODE_ENV="development"

# ─── Site (opcional) ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_CLARITY_ID="xxxxxxxxxx"
NEXT_PUBLIC_GSC_VERIFICATION="google-site-verification-code"
NEXT_PUBLIC_WHATSAPP="5511999999999"

# Instagram Agent — Meta Graph API (Etapa 5)
META_GRAPH_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
INSTAGRAM_AUTO_PUBLISH=false
# Métricas demo sem Meta (apenas desenvolvimento)
# INSTAGRAM_METRICS_DEMO=false
# META_METRICS_CRON_SECRET=
# Opcional: chave dedicada para criptografar token no banco (fallback: JWT_SECRET)
# META_TOKEN_ENCRYPTION_KEY=
# Secret para cron chamar POST /api/admin/instagram/publish/run-due sem sessão admin
# META_PUBLISH_CRON_SECRET=

# Instagram Agent — IA de imagem (Etapa 3, opcional)
# OPENAI_API_KEY=""
# IMAGE_GEN_PROVIDER="openai"
