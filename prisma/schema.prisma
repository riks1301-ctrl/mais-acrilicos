generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  posts     PostTag[]
  createdAt DateTime  @default(now())
}

model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String    @db.Text
  coverImage      String?
  metaTitle       String?
  metaDescription String?
  keywords        String?
  published       Boolean   @default(false)
  featured        Boolean   @default(false)
  readingTime     Int       @default(5)
  views           Int       @default(0)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  tags            PostTag[]
  seoScore        Int       @default(0)
  autoGenerated   Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([slug])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String   @db.Text
  shortDesc       String
  features        String[]
  image           String?
  gallery         String[]
  segment         String?
  featured        Boolean  @default(false)
  order           Int      @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Segment {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String   @db.Text
  shortDesc       String
  benefits        String[]
  image           String?
  featured        Boolean  @default(false)
  order           Int      @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  client      String?
  segment     String?
  image       String
  gallery     String[]
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  segment   String?
  product   String?
  message   String   @db.Text
  budget    String?
  status    String   @default("novo")
  source    String   @default("site")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoArticleQueue {
  id          String    @id @default(cuid())
  title       String
  keywords    String
  category    String?
  status      String    @default("pending")
  postId      String?
  generatedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ─── Agente Instagram ───────────────────────────────────────────────────────

enum IgPostFormat {
  FEED
  CAROUSEL
  STORY
  REELS
}

enum IgPostStatus {
  IDEA
  CREATING
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  ERROR
}

enum IgContentType {
  BEFORE_AFTER
  BEHIND_SCENES
  PRODUCT_SHOWCASE
  EDUCATIONAL_CAROUSEL
  DIRECT_OFFER
  SEASONAL
  REELS_PRODUCTION
  RETAIL_TIPS
  MATERIAL_COMPARISON
  PDV_IDEAS
  SOCIAL_PROOF
  TESTIMONIAL
  PRODUCT_CATALOG
}

enum IgPublicationMode {
  MANUAL
  AUTO
}

enum IgImageCategory {
  OBRA_PRONTA
  BASTIDORES
  ACRILICO
  DISPLAY
  FACHADA
  BANNER
  ADESIVO
  LUMINOSO
  PDV
  ANTES_DEPOIS
  LETRAS_CAIXA
  TOTEM
}

enum IgImageStatus {
  AVAILABLE
  IN_REVIEW
  ARCHIVED
}

enum IgArtGenStatus {
  IDLE
  GENERATING
  READY
  FAILED
}

enum IgImageType {
  REAL
  MOCKUP
  CONCEPT
  COMMERCIAL_ART
}

enum IgVisualSource {
  REAL
  MOCKUP
  AI
  MIXED
}

enum IgPromptPurpose {
  FEED_SQUARE
  FEED_PORTRAIT
  STORY_REELS
  REELS_COVER
  CAROUSEL
}

enum IgPublicationChannel {
  FEED
  STORY
  REELS
  CAROUSEL
}

enum IgMetaMode {
  DISABLED
  TEST
  ACTIVE
}

model InstagramBrandConfig {
  id                 String            @id @default(cuid())
  companyName        String
  instagramHandle    String
  segment            String
  tone               String
  mainCta            String
  whatsappNumber     String
  targetAudience     String[]
  differentials      String[]
  primaryHashtags    String[]
  localHashtags      String[]
  logoUrl            String?
  brandColors        Json?
  brandFonts         Json?
  artTemplateSet     String            @default("carousel")
  visualGuidelines   String?           @db.Text
  publicationMode    IgPublicationMode @default(MANUAL)
  metaConnected      Boolean           @default(false)
  metaMode           IgMetaMode        @default(DISABLED)
  metaAutoPublish    Boolean           @default(false)
  metaPageId         String?
  metaIgUserId       String?
  metaAppId          String?
  metaAccessTokenEnc String?           @db.Text
  metaTokenExpiresAt DateTime?
  metaLastError      String?           @db.Text
  metaLastValidatedAt DateTime?
  googleDriveFolderId String?
  googleDriveLocalPath String?
  googleDriveLastSyncAt DateTime?
  googleDriveLastSyncError String?      @db.Text
  googleDriveSyncCount Int              @default(0)
  personas           InstagramPersona[]
  campaigns          InstagramCampaign[]
  posts              InstagramPost[]
  calendarEntries    EditorialCalendarEntry[]
  images             InstagramImage[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model InstagramPersona {
  id            String               @id @default(cuid())
  name          String
  description   String               @db.Text
  painPoints    String[]
  goals         String[]
  segments      String[]
  brandConfigId String
  brandConfig   InstagramBrandConfig @relation(fields: [brandConfigId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model InstagramCampaign {
  id            String               @id @default(cuid())
  name          String
  description   String?              @db.Text
  startDate     DateTime?
  endDate       DateTime?
  goal          String?
  status        String               @default("draft")
  brandConfigId String
  brandConfig   InstagramBrandConfig @relation(fields: [brandConfigId], references: [id], onDelete: Cascade)
  posts         InstagramPost[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model InstagramPost {
  id               String               @id @default(cuid())
  title            String
  idea             String?              @db.Text
  format           IgPostFormat         @default(FEED)
  contentType      IgContentType?
  status           IgPostStatus         @default(IDEA)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  suggestedDate    DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?              @db.Text
  finalCaption     String?              @db.Text
  finalCta         String?
  finalHashtags    String?
  internalNotes    String?              @db.Text
  publicationChannel IgPublicationChannel?
  publicationNotes String?              @db.Text
  manualPublished  Boolean              @default(false)
  approvedByAdminId String?
  instagramMediaId String?
  metaMediaContainerId String?
  metaPublishError   String?              @db.Text
  metaLastPublishAttempt DateTime?
  metaPublishMode    String?
  performanceScore   Float?
  hybridScore        Float?
  scoreDelta         Float?
  lastMetricsSyncAt  DateTime?
  critiqueNotes    String?              @db.Text
  visualSource     IgVisualSource?
  visualFormat     String?
  artGenStatus     IgArtGenStatus       @default(IDLE)
  artGenError      String?              @db.Text
  artGenStartedAt  DateTime?
  artGenFinishedAt DateTime?
  artGenProgress   Int                  @default(0)
  artGenTotal      Int                  @default(0)
  brandConfigId    String
  brandConfig      InstagramBrandConfig @relation(fields: [brandConfigId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         InstagramCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  captions         InstagramCaption[]
  imagePrompts     InstagramImagePrompt[]
  postImages       InstagramPostImage[]
  carousel         InstagramCarousel?
  metrics          InstagramMetric[]
  approvals        InstagramApproval[]
  calendarEntries  EditorialCalendarEntry[]
  publicationLogs  PublicationLog[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, scheduledFor])
  @@index([brandConfigId, createdAt])
  @@index([instagramMediaId])
  @@index([status, publishedAt])
}

model InstagramCaption {
  id         String        @id @default(cuid())
  postId     String
  post       InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  version    String        @default("A")
  hook       String
  body       String        @db.Text
  cta        String
  hashtags   String
  isSelected Boolean       @default(false)
  critique   String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([postId])
}

model InstagramImagePrompt {
  id         String           @id @default(cuid())
  postId     String
  post       InstagramPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  prompt     String           @db.Text
  format     String
  purpose    IgPromptPurpose?
  imageType  IgImageType      @default(CONCEPT)
  isConcept  Boolean          @default(true)
  styleNotes String?
  createdAt  DateTime         @default(now())
}

model InstagramImage {
  id              String                   @id @default(cuid())
  brandConfigId   String?
  brandConfig     InstagramBrandConfig?    @relation(fields: [brandConfigId], references: [id], onDelete: SetNull)
  category        IgImageCategory?
  description     String?                  @db.Text
  tags            String[]
  serviceId       String?
  service         InstagramService?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clientProject   String?
  usagePermission String                   @default("uso_interno")
  status          IgImageStatus            @default(IN_REVIEW)
  imageType       IgImageType              @default(REAL)
  url             String
  storageKey      String?
  mimeType        String?
  fileSize        Int?
  filename        String?
  isRealPhoto     Boolean                  @default(true)
  isGenerated     Boolean                  @default(false)
  isConcept       Boolean                  @default(false)
  format          String?
  altText         String?
  sourceProvider  String               @default("upload")
  driveFileId     String?
  driveFolderPath String?
  driveRelativePath String?
  driveMainFolder String?
  driveSubfolder  String?
  clientName      String?
  fileHash        String?
  fileCreatedAt   DateTime?
  fileModifiedAt  DateTime?
  imageWidth      Int?
  imageHeight     Int?
  localPath       String?
  thumbnailUrl    String?
  webViewLink     String?
  webContentLink  String?
  metaPublishUrl  String?
  metaPublishReady Boolean             @default(false)
  postImages      InstagramPostImage[]
  carouselSlides  InstagramCarouselSlide[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([brandConfigId, status, category])
  @@index([status])
  @@index([driveFileId])
  @@index([sourceProvider])
  @@index([clientName])
  @@index([fileHash])
  @@index([driveMainFolder])
}

model InstagramPostImage {
  id      String         @id @default(cuid())
  postId  String
  post    InstagramPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  imageId String
  image   InstagramImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  order   Int            @default(0)
  role    String         @default("attachment")
  createdAt DateTime     @default(now())

  @@unique([postId, imageId])
  @@index([postId, order])
}

model InstagramCarousel {
  id         String                   @id @default(cuid())
  postId     String                   @unique
  post       InstagramPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  exportJson Json?
  slides     InstagramCarouselSlide[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
}

model InstagramCarouselSlide {
  id                String             @id @default(cuid())
  carouselId        String
  carousel          InstagramCarousel  @relation(fields: [carouselId], references: [id], onDelete: Cascade)
  order             Int
  slideType         String
  headline          String
  body              String             @db.Text
  backgroundImageId String?
  backgroundImage   InstagramImage?    @relation(fields: [backgroundImageId], references: [id], onDelete: SetNull)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([carouselId, order])
}

model EditorialCalendarEntry {
  id            String               @id @default(cuid())
  date          DateTime
  dayTheme      String
  notes         String?
  brandConfigId String
  brandConfig   InstagramBrandConfig @relation(fields: [brandConfigId], references: [id], onDelete: Cascade)
  postId        String?
  post          InstagramPost?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([brandConfigId, date])
}

model InstagramMetric {
  id                 String        @id @default(cuid())
  postId             String
  post               InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reach              Int?
  impressions        Int?
  likes              Int?
  comments           Int?
  saves              Int?
  shares             Int?
  profileVisits      Int?
  linkClicks         Int?
  whatsappClicks     Int?
  leads              Int?
  totalEngagement    Int?
  engagementRate     Float?
  unavailableMetrics String[]
  rawInsights        Json?
  source             String        @default("meta")
  collectedAt        DateTime      @default(now())

  @@index([postId, collectedAt])
}

model InstagramApproval {
  id         String        @id @default(cuid())
  postId     String
  post       InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  adminId    String?
  status     String
  notes      String?       @db.Text
  reviewedAt DateTime      @default(now())

  @@index([postId])
}

model PublicationLog {
  id           String        @id @default(cuid())
  postId       String
  post         InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  action       String
  details      Json?
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())

  @@index([postId, createdAt])
}

model InstagramService {
  id          String           @id @default(cuid())
  name        String
  description String           @db.Text
  category    String?
  keywords    String[]
  featured    Boolean          @default(false)
  order       Int              @default(0)
  images      InstagramImage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}
